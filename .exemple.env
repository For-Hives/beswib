# Example .env - do NOT store real secrets here. Replace values before use.

# Public address of the site, without a path: the base of the canonical links, the share images,
# the sitemap, the e-mail links and the PayPal return URLs. Every deployment must set its own
# (https://beswib.com, https://staging.beswib.com): the pages of a production build that has none,
# or a local one, announce https://beswib.com. Read at build time, so changing it needs a new build.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Pocketbase configuration
NEXT_PUBLIC_POCKETBASE_URL=https://api.example.com
POCKETBASE_TOKEN=pb_token_example_1234567890

# Clerk configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example_publishable_key
CLERK_SECRET_KEY=sk_test_example_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_example_signing_secret

# PayPal configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=example_paypal_client_id
PAYPAL_CLIENT_SECRET=example_paypal_client_secret
# Note: BN Code is now hardcoded in paypal.services.ts (CINQUINANDY_SP_PPCP)
# This variable is kept for backward compatibility but is no longer used
PAYPAL_BN_CODE=CINQUINANDY_SP_PPCP
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=EXAMPLE_WEBHOOK_ID

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/EXAMPLE/EXAMPLE

# Resend
RESEND_API_KEY=re_example_api_key

# Notification emails - set to real admin addresses in production
NOTIFY_CONTACT_EMAIL_TO=contact@example.com
NOTIFY_SALES_EMAIL_TO=sales@example.com
NOTIFY_EMAIL_FROM=no-reply@example.com

# Batch chunk size for batch sends (Resend) - default 100
NOTIFY_BATCH_CHUNK_SIZE=100



# sentry
SENTRY_AUTH_TOKEN=sntrys_XXX
SENTRY_DSN=https://sentry_url

# Umami analytics (both optional, for local verification only; leave unset in production)
# Origin of the Umami instance: serves /script.js and receives /api/send. Default: https://umami.wadefade.fr
# NEXT_PUBLIC_UMAMI_HOST="http://localhost:3001"
# Hostnames on which the tracker records (data-domains, comma separated, exact match). Default: beswib.com
# NEXT_PUBLIC_UMAMI_DOMAINS="localhost"
# Server-side events are only sent by a production build (NODE_ENV=production) whose NEXT_PUBLIC_BASE_URL has the hostname beswib.com or www.beswib.com
